# Copy this file to .env (in this hw4/ folder) and fill in your own key.
# Never commit the real .env — it is listed in .gitignore.

# Required for the chat agent (Portkey, OpenAI-compatible gateway).
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: model used by the agent (default gpt-5.6-luna).
CC_MODEL=gpt-5.6-luna

# Optional: set to true when serving over HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
